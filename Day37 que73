#include<stdio.h>
int main()
{
int a[10][10],i,n,i,j,r,c,sum[10];
printf("enter rows and columns");
scanf("%d%d",&r,&c);
printf("enter matrix element");
for(i=0;i<r;i++)
{
  for("j=0;j<c;j++)
    scanf("%d",&a[i][j]);
}
for(i=0;i<r;i++)
{
  sum[i]=0;
  for(j=0;j<c;j++)
    sum[i]=sum[i]+a[i][j];
}
printf("sum of each row");
for(i=0;i<r;i++)
printf("%d",sum[i]);
return 0;
}
